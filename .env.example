# ------------------------------------------------------------------
# ChessMaster — production database (Supabase)
# ------------------------------------------------------------------
# Copy this file to `.env` (Vite auto-loads it) and fill in the values
# from your Supabase project settings → API.
#
# With these set, authentication runs against Supabase Auth (bcrypt
# hashing server-side) and profiles/ratings/game history live in the
# Postgres tables defined in supabase/schema.sql, protected by
# row-level security so each user can only access their own rows.
#
# Without these variables the app falls back to its embedded IndexedDB
# database (PBKDF2-hashed passwords, 30-day sessions) so it still works
# fully offline / in preview.
#
# The anon key is a PUBLIC client key by design — security comes from
# RLS. Never commit a service-role key to the frontend.
# ------------------------------------------------------------------

VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key
